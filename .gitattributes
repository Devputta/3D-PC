# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicit text file formats
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf

# Binary asset formats
*.woff binary
*.woff2 binary
*.ttf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf
